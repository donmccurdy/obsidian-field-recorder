{
	"name": "obsidian-field-recorder",
	"version": "1.1.1",
	"description": "Audio recorder with quality settings and waveform visualization.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . && biome check",
		"format": "biome check --write"
	},
	"keywords": [],
	"license": "Parity-7.0.0",
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@eslint/js": "^9.39.4",
		"@preact/signals-core": "^1.14.4",
		"@types/node": "^22.15.17",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"obsidian": "^1.14.4",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1"
	}
}
